{
 "redirects": [
  {
   "source": "/app",
   "destination": "/app/",
   "permanent": false
  }
 ],
 "rewrites": [
  {
   "source": "/app/",
   "destination": "/app/sistema.html"
  }
 ],
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "Referrer-Policy",
     "value": "strict-origin-when-cross-origin"
    },
    {
     "key": "X-Frame-Options",
     "value": "DENY"
    }
   ]
  },
  {
   "source": "/(index.html|marca.html)?",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-cache"
    }
   ]
  },
  {
   "source": "/app/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-cache"
    }
   ]
  }
 ]
}